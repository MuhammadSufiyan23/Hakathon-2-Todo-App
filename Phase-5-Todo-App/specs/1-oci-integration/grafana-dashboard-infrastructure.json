{
  "dashboard": {
    "id": null,
    "title": "Infrastructure Metrics",
    "tags": ["kubernetes", "oke", "infrastructure", "nodes"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 16,
    "version": 1,
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"],
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "Cluster Status",
        "type": "stat",
        "span": 3,
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "prefix": "",
        "postfix": " nodes ready",
        "colorValue": true,
        "colors": ["#299c46", "rgba(237, 129, 40, 0.89)", "#d44a34"]
      },
      {
        "id": 2,
        "title": "Pod Status",
        "type": "stat",
        "span": 3,
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "prefix": "",
        "postfix": " pods running",
        "colorValue": true,
        "colors": ["#299c46", "rgba(237, 129, 40, 0.89)", "#d44a34"]
      },
      {
        "id": 3,
        "title": "Node CPU Usage",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "CPU %",
            "show": true
          }
        ]
      },
      {
        "id": 4,
        "title": "Node Memory Usage",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemFree_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Memory %",
            "show": true
          }
        ]
      },
      {
        "id": 5,
        "title": "Pod CPU Usage (Top 10)",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "topk(10, sum(rate(container_cpu_usage_seconds_total[5m])) by (pod, namespace))",
            "legendFormat": "{{namespace}}/{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "CPU Usage",
            "show": true
          }
        ]
      },
      {
        "id": 6,
        "title": "Pod Memory Usage (Top 10)",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "topk(10, sum(container_memory_working_set_bytes) by (pod, namespace))",
            "legendFormat": "{{namespace}}/{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Memory (bytes)",
            "show": true
          }
        ]
      },
      {
        "id": 7,
        "title": "Disk Usage",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "100 - ((node_filesystem_avail_bytes * 100) / node_filesystem_size_bytes)",
            "legendFormat": "{{instance}}: {{mountpoint}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Disk %",
            "show": true
          }
        ]
      },
      {
        "id": 8,
        "title": "Network I/O",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(node_network_receive_bytes_total[5m])) by (instance)",
            "legendFormat": "{{instance}} (receive)",
            "refId": "A"
          },
          {
            "expr": "sum(rate(node_network_transmit_bytes_total[5m])) by (instance)",
            "legendFormat": "{{instance}} (transmit)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Bytes/sec",
            "show": true
          }
        ]
      },
      {
        "id": 9,
        "title": "Pod Restarts",
        "type": "graph",
        "span": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum(increase(kube_pod_container_status_restarts_total[10m])) by (pod, namespace)",
            "legendFormat": "{{namespace}}/{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Restarts",
            "show": true
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_namespace_created, namespace)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "node",
          "type": "query",
          "query": "label_values(kube_node_created, node)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "refresh": "5s",
    "schemaVersion": 16,
    "version": 1
  },
  "folderId": 0,
  "overwrite": false
}